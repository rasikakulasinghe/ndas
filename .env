# Production Environment Configuration
# NDAS - Neurodevelopmental Assessment System

# SECURITY: New SECRET_KEY generated for production
SECRET_KEY=cp0&wot$tsxy#bma_8jw5=0#3#o+2dq@4s8iooca_5!n-^_u!g

# Security Settings
DEBUG=False
ALLOWED_HOSTS=demo-ndas.rasikakulasinghe.com,www.demo-ndas.rasikakulasinghe.com,127.0.0.1,localhost

# SSL/HTTPS Configuration
USE_SSL_PROXY=True
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=True
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Database Configuration - PostgreSQL for Production
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ndas_production
# DB_USER=ndas_user
# DB_PASSWORD=your-secure-database-password-here
# DB_HOST=localhost
# DB_PORT=5432

# Static and Media Files - Absolute paths for production
STATIC_URL=/static/
MEDIA_URL=/media/
STATIC_ROOT=/var/www/ndas/static/
MEDIA_ROOT=/var/www/ndas/media/

# Email Configuration - Production SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-app-password-here

# Session Security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_AGE=3600
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# CSRF Security
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True

# Cache Configuration - Redis for Production
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATELIMIT_ENABLE=True

# Logging Configuration
LOG_LEVEL=INFO

# File Upload Security
MAX_UPLOAD_SIZE=104857600
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,wmv,webm
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,txt

# Error Tracking (Optional - Configure if using Sentry)
# SENTRY_DSN=your-sentry-dsn-here

# Backup Configuration
BACKUP_PATH=/var/backups/ndas/
BACKUP_RETENTION_DAYS=30

# Additional Production Settings
COMPRESS_ENABLED=True
COMPRESS_OFFLINE=True
