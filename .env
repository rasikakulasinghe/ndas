# Production Environment Configuration
# NDAS - Neurodevelopmental Assessment System
# For cPanel Shared Hosting Deployment with SQLite Database
# Copy this file to .env for production deployment

# CRITICAL: Generate a new secret key for production
# Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cp0&wot$tsxy#bma_8jw5=0#3#o+2dq@4s8iooca_5!n-^_u!g

# Production Security Settings
DEBUG=False
ALLOWED_HOSTS=demo-ndas.rasikakulasinghe.com,https://demo-ndas.rasikakulasinghe.com/,www.demo-ndas.rasikakulasinghe.com

# Database Configuration - SQLite for Production
# SQLite will be used by default, database file will be in project root
# Ensure the database file has proper permissions (644) on cPanel
# No additional database configuration needed for SQLite
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Static and Media Files - cPanel hosting paths
# Update these paths according to your cPanel file structure
STATIC_URL=/static/
MEDIA_URL=/media/
STATIC_ROOT=/home/rasikakulasinghe/public_html/demo-ndas.rasikakulasinghe.com/static/
MEDIA_ROOT=/home/rasikakulasinghe/public_html/demo-ndas.rasikakulasinghe.com/media/

# Email Configuration - cPanel SMTP
# Update with your cPanel email settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password

# SSL/HTTPS Configuration for cPanel
# Most cPanel hosts provide SSL, adjust based on your host's configuration
USE_SSL_PROXY=True
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Session Security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_AGE=3600
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# CSRF Security
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True

# Cache Configuration - File-based cache for shared hosting
# Redis may not be available on shared hosting
# REDIS_URL=  # Leave empty to use file-based cache

# Rate Limiting - Enabled for production
RATELIMIT_ENABLE=True

# Logging Configuration
LOG_LEVEL=INFO

# File Upload Security
MAX_UPLOAD_SIZE=104857600  # 100MB (adjust based on your hosting limits)
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,wmv,webm,mkv
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,txt

# Error Tracking (Optional - Configure if using Sentry)
# SENTRY_DSN=your-sentry-dsn-here

# Backup Configuration - Adjust paths for cPanel
BACKUP_PATH=/home/yourusername/backups/ndas/
BACKUP_RETENTION_DAYS=30

# Additional Production Settings
COMPRESS_ENABLED=True
COMPRESS_OFFLINE=True

# cPanel Specific Settings
# Time Zone - Set according to your location
TIME_ZONE=UTC

# Language Code
LANGUAGE_CODE=en-us

# cPanel Python App Settings (if applicable)
# Some hosts require specific WSGI application path
# WSGI_APPLICATION=ndas.wsgi.application

# Database Backup Settings for SQLite
# Automatic backup can be done via cPanel cron jobs
DB_BACKUP_ENABLED=True
DB_BACKUP_SCHEDULE=daily

# File Permissions Note:
# Ensure proper file permissions on cPanel:
# - Python files: 644
# - Directories: 755
# - Database file (db.sqlite3): 644
# - Media directory: 755
# - Static directory: 755
