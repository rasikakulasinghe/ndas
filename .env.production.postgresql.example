# ============================================================================
# NDAS Production Environment Configuration (PostgreSQL)
# Neurodevelopmental Assessment System
# ============================================================================
# For production deployment on VPS/Cloud with PostgreSQL database
# Use this for: AWS, DigitalOcean, Linode, Heroku, etc.
# Copy this file to .env and customize for your server
#
# DEPLOYMENT CHECKLIST:
# [ ] Generate new SECRET_KEY
# [ ] Update ALLOWED_HOSTS with your domain
# [ ] Configure PostgreSQL database
# [ ] Configure email settings
# [ ] Update file paths (STATIC_ROOT, MEDIA_ROOT)
# [ ] Set SESSION_COOKIE_SECURE=True (using HTTPS)
# [ ] Configure Redis (optional but recommended)
# [ ] Review security settings
# ============================================================================

# ============================================================================
# 1. CORE DJANGO SETTINGS
# ============================================================================

# CRITICAL: Generate a new secret key for production
# Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY-IN-PRODUCTION

# Production mode - MUST be False in production
DEBUG=False

# Allowed hosts - Add your domain(s) here (comma-separated, no spaces)
# Example: yourdomain.com,www.yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ============================================================================
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================

DB_ENGINE=django.db.backends.postgresql
DB_NAME=ndas_production
DB_USER=ndas_user
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5432

# PostgreSQL connection options (applied automatically in settings.py)
# - Connection timeout: 60 seconds
# - Transaction isolation: read committed
# - Connection pooling: 300 seconds (CONN_MAX_AGE)

# Database creation commands:
# sudo -u postgres psql
# CREATE DATABASE ndas_production;
# CREATE USER ndas_user WITH PASSWORD 'your-secure-password';
# ALTER ROLE ndas_user SET client_encoding TO 'utf8';
# ALTER ROLE ndas_user SET default_transaction_isolation TO 'read committed';
# ALTER ROLE ndas_user SET timezone TO 'UTC';
# GRANT ALL PRIVILEGES ON DATABASE ndas_production TO ndas_user;
# \q

# ============================================================================
# 3. STATIC AND MEDIA FILES
# ============================================================================

# URLs for static and media files
STATIC_URL=/static/
MEDIA_URL=/media/

# Server paths - UPDATE THESE for your hosting environment
# Common paths:
# - Nginx: /var/www/yourdomain.com/
# - Apache: /var/www/html/yourdomain.com/
# - Custom: /opt/ndas/

STATIC_ROOT=/var/www/yourdomain.com/static/
MEDIA_ROOT=/var/www/yourdomain.com/media/

# Recommended directory structure:
# /var/www/yourdomain.com/
#   ├── static/           (collected static files)
#   └── media/            (uploaded files)
# /opt/ndas/              (application code)
#   ├── manage.py
#   ├── requirements.txt
#   └── ...

# ============================================================================
# 4. EMAIL CONFIGURATION
# ============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Settings - Update with your email provider
# Gmail: smtp.gmail.com:587 (use app password)
# SendGrid: smtp.sendgrid.net:587
# AWS SES: email-smtp.region.amazonaws.com:587
# Custom: mail.yourdomain.com:587

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Email credentials
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your-secure-email-password

# Default sender email
DEFAULT_FROM_EMAIL=NDAS System <noreply@yourdomain.com>

# Email timeout (seconds)
EMAIL_TIMEOUT=10

# Email verification settings
EMAIL_VERIFICATION_REQUIRED=True
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24

# ============================================================================
# 5. CACHE CONFIGURATION (Redis - RECOMMENDED)
# ============================================================================

# Redis for caching and sessions (highly recommended for production)
# Local: redis://localhost:6379/0
# Remote: redis://username:password@host:port/0
# Redis Cloud: redis://:password@host:port/0

REDIS_URL=redis://localhost:6379/0

# If Redis is not available, leave empty to use file-based cache
# REDIS_URL=

# Redis installation (Ubuntu/Debian):
# sudo apt update
# sudo apt install redis-server
# sudo systemctl enable redis-server
# sudo systemctl start redis-server

# ============================================================================
# 6. SSL/HTTPS CONFIGURATION
# ============================================================================

# Enable HTTPS redirects and security headers
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=True

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Only enable HSTS after confirming HTTPS works correctly!
# HSTS tells browsers to ONLY use HTTPS for 1 year

# ============================================================================
# 7. COOKIE SECURITY
# ============================================================================

# Secure cookies (requires HTTPS)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Session timeout (seconds) - 3600 = 1 hour
SESSION_COOKIE_AGE=3600

# ============================================================================
# 8. RATE LIMITING
# ============================================================================

# Enable rate limiting to prevent abuse
RATELIMIT_ENABLE=True

# Rate limiting uses cache (Redis or file-based)

# ============================================================================
# 9. FILE UPLOAD LIMITS
# ============================================================================

# Maximum upload sizes (in bytes)
# 104857600 = 100MB
# 2147483648 = 2GB
MAX_UPLOAD_SIZE=2147483648

# Allowed file extensions (comma-separated, no spaces)
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,wmv,webm,mkv
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,txt

# ============================================================================
# 10. LOGGING
# ============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Logs directory: /path/to/ndas/logs/
# Ensure this directory exists and has write permissions
# sudo mkdir -p /opt/ndas/logs
# sudo chown www-data:www-data /opt/ndas/logs

# ============================================================================
# 11. COMPRESSION
# ============================================================================

# Enable static file compression
COMPRESS_ENABLED=True
COMPRESS_OFFLINE=True

# Run before deployment:
# python manage.py compress

# ============================================================================
# 12. ERROR TRACKING (OPTIONAL - Sentry)
# ============================================================================

# Sentry for error tracking and monitoring
# Sign up at: https://sentry.io
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ============================================================================
# 13. BACKUP CONFIGURATION
# ============================================================================

# Backup directory (ensure it exists and has proper permissions)
BACKUP_PATH=/var/backups/ndas/

# Backup retention
BACKUP_RETENTION_DAYS=30

# Database backup settings
DB_BACKUP_ENABLED=True
DB_BACKUP_SCHEDULE=daily

# PostgreSQL backup commands (add to crontab):
# Daily at 2 AM:
# 0 2 * * * pg_dump -U ndas_user ndas_production > /var/backups/ndas/db_$(date +\%Y\%m\%d).sql

# ============================================================================
# 14. TIMEZONE AND LOCALIZATION
# ============================================================================

# Server timezone
# Options: UTC, Asia/Kolkata, America/New_York, Europe/London, etc.
TIME_ZONE=Asia/Kolkata

# Language code
LANGUAGE_CODE=en-us

# ============================================================================
# DEPLOYMENT GUIDE (Ubuntu/Debian with Nginx + Gunicorn)
# ============================================================================
#
# 1. Install system dependencies:
#    sudo apt update
#    sudo apt install python3-pip python3-venv postgresql nginx redis-server
#    sudo apt install ffmpeg  # For video processing
#
# 2. Create application directory:
#    sudo mkdir -p /opt/ndas
#    sudo chown $USER:$USER /opt/ndas
#    cd /opt/ndas
#
# 3. Clone and setup:
#    git clone <repository-url> .
#    python3 -m venv venv
#    source venv/bin/activate
#    pip install -r requirements.txt
#    pip install gunicorn psycopg2-binary
#
# 4. Setup environment:
#    cp .env.production.postgresql.example .env
#    nano .env  # Edit with your settings
#    chmod 600 .env
#
# 5. Create PostgreSQL database (see section 2 above)
#
# 6. Run migrations and collect static:
#    python manage.py migrate
#    python manage.py collectstatic --noinput
#    python manage.py createsuperuser
#
# 7. Create directories:
#    sudo mkdir -p /var/www/yourdomain.com/static
#    sudo mkdir -p /var/www/yourdomain.com/media
#    sudo mkdir -p /var/backups/ndas
#    sudo mkdir -p /opt/ndas/logs
#    sudo chown -R www-data:www-data /var/www/yourdomain.com
#    sudo chown -R www-data:www-data /opt/ndas/logs
#
# 8. Create Gunicorn systemd service:
#    sudo nano /etc/systemd/system/ndas.service
#
#    [Unit]
#    Description=NDAS Gunicorn daemon
#    After=network.target
#
#    [Service]
#    User=www-data
#    Group=www-data
#    WorkingDirectory=/opt/ndas
#    Environment="PATH=/opt/ndas/venv/bin"
#    ExecStart=/opt/ndas/venv/bin/gunicorn \
#              --workers 3 \
#              --bind unix:/opt/ndas/ndas.sock \
#              ndas.wsgi:application
#
#    [Install]
#    WantedBy=multi-user.target
#
# 9. Start and enable service:
#    sudo systemctl start ndas
#    sudo systemctl enable ndas
#
# 10. Configure Nginx:
#     sudo nano /etc/nginx/sites-available/ndas
#
#     server {
#         listen 80;
#         server_name yourdomain.com www.yourdomain.com;
#
#         client_max_body_size 2G;
#
#         location /static/ {
#             alias /var/www/yourdomain.com/static/;
#         }
#
#         location /media/ {
#             alias /var/www/yourdomain.com/media/;
#         }
#
#         location / {
#             proxy_pass http://unix:/opt/ndas/ndas.sock;
#             proxy_set_header Host $host;
#             proxy_set_header X-Real-IP $remote_addr;
#             proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#             proxy_set_header X-Forwarded-Proto $scheme;
#         }
#     }
#
# 11. Enable site and reload Nginx:
#     sudo ln -s /etc/nginx/sites-available/ndas /etc/nginx/sites-enabled/
#     sudo nginx -t
#     sudo systemctl reload nginx
#
# 12. Setup SSL with Let's Encrypt:
#     sudo apt install certbot python3-certbot-nginx
#     sudo certbot --nginx -d yourdomain.com -d www.yourdomain.com
#
# 13. Setup automated backups (crontab):
#     sudo crontab -e
#     # Add:
#     0 2 * * * pg_dump -U ndas_user ndas_production > /var/backups/ndas/db_$(date +\%Y\%m\%d).sql
#     0 3 * * * find /var/backups/ndas/ -name "db_*.sql" -mtime +30 -delete
#
# 14. Security checklist:
#     - Run: python manage.py check --deploy
#     - Verify firewall: sudo ufw allow 'Nginx Full'
#     - Test SSL: https://www.ssllabs.com/ssltest/
#     - Monitor logs: sudo journalctl -u ndas -f
#
# ============================================================================
