# ============================================================================
# NDAS Production Environment Configuration -- DEMO SITE
# Domain: demo.ndas.lk
# Neurodevelopmental Assessment System
# ============================================================================
# For production deployment on shared hosting (cPanel) with SQLite.
# Copy this file to .env INSIDE THIS DOMAIN'S OWN APPLICATION ROOT
# (e.g. /home/rasikakulasinghe/ndas-demo/) -- a separate checkout/app
# root from ndas.lk, each with its own venv, .env, and db.sqlite3. Sharing
# one application root between the two domains means sharing one database.
#
# DEPLOYMENT CHECKLIST:
# [ ] Generate a new SECRET_KEY (must differ from the ndas.lk one)
# [ ] Confirm ALLOWED_HOSTS matches demo.ndas.lk exactly
# [ ] Configure email settings for this domain
# [ ] Update file paths (STATIC_ROOT, MEDIA_ROOT) for this domain's public_html folder
# [ ] Set SESSION_COOKIE_SECURE=True once HTTPS is verified working
# [ ] Create/point passenger_wsgi.py (see passenger_wsgi.py.example) at THIS app root's venv
# ============================================================================

# ============================================================================
# 1. CORE DJANGO SETTINGS
# ============================================================================

# CRITICAL: Generate a new secret key for this site specifically -- do not
# reuse the ndas.lk key or any development key.
# Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY-FOR-DEMO-NDAS-LK

# Production mode - MUST be False in production
DEBUG=False

# Allowed hosts - comma-separated, no spaces
ALLOWED_HOSTS=demo.ndas.lk,www.demo.ndas.lk

# ============================================================================
# 2. DATABASE CONFIGURATION
# ============================================================================
# SQLite (default for shared hosting). Leave DB_ENGINE empty -- Django uses
# BASE_DIR/db.sqlite3, i.e. the db.sqlite3 inside THIS application root.
# As long as this app root is separate from the ndas.lk one, the databases
# are automatically separate too.

# DB_ENGINE=  # Leave empty for SQLite
# DB_NAME=    # Leave empty for SQLite

# Note: Ensure db.sqlite3 has proper permissions (644) after deployment
# Set directory permissions to 755

# ============================================================================
# 3. STATIC AND MEDIA FILES
# ============================================================================

STATIC_URL=/static/
MEDIA_URL=/media/

# Server paths - UPDATE for your hosting environment.
# Replace rasikakulasinghe with your actual cPanel username.
STATIC_ROOT=/home/rasikakulasinghe/public_html/demo.ndas.lk/static/
MEDIA_ROOT=/home/rasikakulasinghe/public_html/demo.ndas.lk/media/

# File structure on server:
# /home/rasikakulasinghe/
#   |-- public_html/
#   |   `-- demo.ndas.lk/
#   |       |-- static/     (collected static files)
#   |       `-- media/      (uploaded files)
#   `-- ndas-demo/          (this app's code, OUTSIDE public_html)
#       |-- db.sqlite3
#       |-- manage.py
#       `-- ...

# ============================================================================
# 4. EMAIL CONFIGURATION
# ============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=mail.ndas.lk
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Dedicated mailbox for the demo site -- keep separate from ndas.lk's.
EMAIL_HOST_USER=noreply@demo.ndas.lk
EMAIL_HOST_PASSWORD=CHANGE-THIS

DEFAULT_FROM_EMAIL=noreply@demo.ndas.lk

EMAIL_TIMEOUT=10

EMAIL_VERIFICATION_REQUIRED=True
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24

# ============================================================================
# 5. SSL/HTTPS CONFIGURATION
# ============================================================================
# Most cPanel hosts provide free SSL certificates via Let's Encrypt/AutoSSL.
# Only flip these to True once HTTPS is confirmed working for demo.ndas.lk --
# turning them on before the certificate is issued will lock you out with
# redirect loops.

SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=True

SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================================================
# 6. COOKIE SECURITY
# ============================================================================
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

SESSION_COOKIE_AGE=3600

# ============================================================================
# 7. CACHE CONFIGURATION
# ============================================================================
# For shared hosting without Redis, leave empty to use file-based cache.
REDIS_URL=

# ============================================================================
# 8. RATE LIMITING
# ============================================================================
RATELIMIT_ENABLE=True

# ============================================================================
# 9. FILE UPLOAD LIMITS
# ============================================================================
MAX_UPLOAD_SIZE=104857600

ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,wmv,webm,mkv
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,txt

# ============================================================================
# 10. LOGGING
# ============================================================================
# Demo site: DEBUG stays False (no stack traces/source shown to visitors) but
# LOG_LEVEL=DEBUG keeps verbose detail flowing to logs/django.log server-side,
# per the demo profile's "debug and log on" requirement.
LOG_LEVEL=DEBUG

# Logs are created in THIS app root's logs/ directory -- ensure it exists
# and is writable (755).

# ============================================================================
# 11. COMPRESSION
# ============================================================================
COMPRESS_ENABLED=True
COMPRESS_OFFLINE=True

# ============================================================================
# 12. ERROR TRACKING (OPTIONAL)
# ============================================================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# 13. BACKUP CONFIGURATION
# ============================================================================
# Keep this separate from the ndas.lk backup path so the two sites' backups
# never overwrite each other.
BACKUP_PATH=/home/rasikakulasinghe/backups/ndas-demo/

BACKUP_RETENTION_DAYS=30

DB_BACKUP_ENABLED=True
DB_BACKUP_SCHEDULE=daily

# ============================================================================
# 14. TIMEZONE AND LOCALIZATION
# ============================================================================
TIME_ZONE=Asia/Colombo

LANGUAGE_CODE=en-us

# ============================================================================
# DEPLOYMENT NOTES (DEMO SITE)
# ============================================================================
#
# 1. This profile assumes a SEPARATE cPanel "Python App" / application root
#    from ndas.lk -- e.g. /home/rasikakulasinghe/ndas-demo/ -- with its
#    own venv. Do not point both domains at the same application root.
#
# 2. Switch this app root's .env with:
#      python scripts/switch_env.py production-demo
#
# 3. Create passenger_wsgi.py in THIS app root from passenger_wsgi.py.example,
#    pointing INTERP at this app root's own venv interpreter.
#
# 4. After deployment, run (from this app root):
#    python manage.py collectstatic --noinput
#    python manage.py migrate
#
# ============================================================================
