# ============================================================================
# NDAS Production Environment Configuration
# Neurodevelopmental Assessment System
# ============================================================================
# For production deployment on shared hosting (cPanel) with SQLite
# Copy this file to .env and customize for your server
#
# DEPLOYMENT CHECKLIST:
# [ ] Generate new SECRET_KEY
# [ ] Update ALLOWED_HOSTS with your domain
# [ ] Configure email settings
# [ ] Update file paths (STATIC_ROOT, MEDIA_ROOT)
# [ ] Set SESSION_COOKIE_SECURE=True if using HTTPS
# [ ] Review security settings
# ============================================================================

# ============================================================================
# 1. CORE DJANGO SETTINGS
# ============================================================================

# CRITICAL: Generate a new secret key for production
# Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY-IN-PRODUCTION

# Production mode - MUST be False in production
DEBUG=False

# Allowed hosts - Add your domain(s) here (comma-separated, no spaces)
# Example: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=demo-ndas.rasikakulasinghe.com,www.demo-ndas.rasikakulasinghe.com

# ============================================================================
# 2. DATABASE CONFIGURATION
# ============================================================================
# SQLite configuration (default for shared hosting)
# Leave DB_ENGINE empty to use SQLite - no additional configuration needed
# Database file will be created as db.sqlite3 in project root

# DB_ENGINE=  # Leave empty for SQLite
# DB_NAME=    # Leave empty for SQLite

# Note: Ensure db.sqlite3 has proper permissions (644) after deployment
# Set directory permissions to 755

# ============================================================================
# 3. STATIC AND MEDIA FILES
# ============================================================================

# URLs for static and media files (usually don't need to change)
STATIC_URL=/static/
MEDIA_URL=/media/

# Server paths - UPDATE THESE for your hosting environment
# cPanel example: /home/username/public_html/yourdomain.com/
# Replace 'rasikakulasinghe' with your cPanel username
# Replace 'demo-ndas.rasikakulasinghe.com' with your domain folder

STATIC_ROOT=/home/rasikakulasinghe/public_html/demo-ndas.rasikakulasinghe.com/static/
MEDIA_ROOT=/home/rasikakulasinghe/public_html/demo-ndas.rasikakulasinghe.com/media/

# File structure on server:
# /home/username/
#   ├── public_html/
#   │   └── yourdomain.com/
#   │       ├── static/     (collected static files)
#   │       └── media/      (uploaded files)
#   └── ndas/               (project code - outside public_html)
#       ├── db.sqlite3
#       ├── manage.py
#       └── ...

# ============================================================================
# 4. EMAIL CONFIGURATION
# ============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# cPanel Email Settings - Update with your actual email configuration
# For cPanel, use: mail.yourdomain.com
EMAIL_HOST=mail.rasikakulasinghe.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Email credentials - Create a dedicated email account for the system
EMAIL_HOST_USER=noreply@demo-ndas.rasikakulasinghe.com
EMAIL_HOST_PASSWORD=rasikakulasinghe19841229

# Default sender email
DEFAULT_FROM_EMAIL=noreply@demo-ndas.rasikakulasinghe.com

# Email timeout (seconds)
EMAIL_TIMEOUT=10

# Email verification settings
EMAIL_VERIFICATION_REQUIRED=True
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24

# ============================================================================
# 5. SSL/HTTPS CONFIGURATION
# ============================================================================
# Most cPanel hosts provide free SSL certificates via Let's Encrypt
# Enable these settings if your domain has SSL configured

# Set to True if using HTTPS (recommended)
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=True

# HSTS settings (only enable if you're sure about HTTPS)
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================================================
# 6. COOKIE SECURITY
# ============================================================================
# Set to True if using HTTPS (same as SECURE_SSL_REDIRECT)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Session timeout (seconds) - 3600 = 1 hour
SESSION_COOKIE_AGE=3600

# ============================================================================
# 7. CACHE CONFIGURATION
# ============================================================================
# For shared hosting without Redis, leave empty to use file-based cache
# If your hosting supports Redis, uncomment and configure:
# REDIS_URL=redis://localhost:6379/0

REDIS_URL=

# ============================================================================
# 8. RATE LIMITING
# ============================================================================
# Enable rate limiting to prevent abuse
RATELIMIT_ENABLE=True

# ============================================================================
# 9. FILE UPLOAD LIMITS
# ============================================================================
# Adjust based on your hosting plan limits
# Sizes in bytes: 104857600 = 100MB, 2147483648 = 2GB

# Maximum upload sizes (in bytes)
MAX_UPLOAD_SIZE=104857600

# Allowed file extensions (comma-separated, no spaces)
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,wmv,webm,mkv
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,txt

# ============================================================================
# 10. LOGGING
# ============================================================================
LOG_LEVEL=INFO

# Logs will be created in: /path/to/ndas/logs/
# Ensure this directory exists and has write permissions (755)

# ============================================================================
# 11. COMPRESSION
# ============================================================================
# Enable static file compression for better performance
COMPRESS_ENABLED=True
COMPRESS_OFFLINE=True

# ============================================================================
# 12. ERROR TRACKING (OPTIONAL)
# ============================================================================
# If using Sentry for error tracking, add your DSN here
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# 13. BACKUP CONFIGURATION
# ============================================================================
# Configure automatic backups via cPanel cron jobs

# Backup directory path (outside public_html for security)
BACKUP_PATH=/home/rasikakulasinghe/backups/ndas/

# Number of days to keep backups
BACKUP_RETENTION_DAYS=30

# Database backup settings
DB_BACKUP_ENABLED=True
DB_BACKUP_SCHEDULE=daily

# ============================================================================
# 14. TIMEZONE AND LOCALIZATION
# ============================================================================
# Set your server's timezone
# Options: UTC, Asia/Kolkata, America/New_York, Europe/London, etc.
TIME_ZONE=Asia/Kolkata

# Language code
LANGUAGE_CODE=en-us

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
#
# 1. File Permissions (IMPORTANT):
#    - Python files: chmod 644 *.py
#    - Directories: chmod 755 directories
#    - Database file: chmod 644 db.sqlite3
#    - Media directory: chmod 755 -R media/
#    - Static directory: chmod 755 -R static/
#    - .env file: chmod 600 .env (restrict to owner only)
#
# 2. After deployment, run:
#    python manage.py collectstatic --noinput
#    python manage.py migrate
#
# 3. Create logs directory:
#    mkdir -p logs
#    chmod 755 logs
#
# 4. Setup cron job for backups (cPanel):
#    Daily at 2 AM: 0 2 * * * cd /home/username/ndas && python manage.py backup_database
#
# 5. Web server configuration:
#    - Passenger (cPanel): Create passenger_wsgi.py
#    - Point document root to public_html/yourdomain.com
#    - Python version: 3.9 or higher
#
# 6. Security checklist:
#    - Run: python manage.py check --deploy
#    - Verify all settings marked with CRITICAL
#    - Test SSL certificate
#    - Test email sending
#    - Review file upload limits
#
# ============================================================================
