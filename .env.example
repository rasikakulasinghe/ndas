# ============================================================================
# NDAS Environment Configuration Template
# Neurodevelopmental Assessment System
# ============================================================================
# This is a template file showing all available configuration options
# Copy this file to .env and customize based on your environment
#
# For specific deployment scenarios, see:
# - .env.development.example     (Local development)
# - .env.production.example      (cPanel/Shared hosting with SQLite)
# - .env.production.postgresql.example  (VPS/Cloud with PostgreSQL)
# ============================================================================

# ============================================================================
# 1. CORE DJANGO SETTINGS
# ============================================================================

# Secret key - REQUIRED
# Development: Use any string
# Production: Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode - REQUIRED
# Development: True
# Production: False (NEVER use True in production!)
DEBUG=True

# Allowed hosts - REQUIRED
# Development: localhost,127.0.0.1
# Production: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# 2. DATABASE CONFIGURATION
# ============================================================================

# Option 1: SQLite (Default - Good for development and small deployments)
# Leave DB_ENGINE empty to use SQLite
# DB_ENGINE=
# DB_NAME=

# Option 2: PostgreSQL (Recommended for production)
# Uncomment and configure:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ndas_db
# DB_USER=ndas_user
# DB_PASSWORD=your-database-password
# DB_HOST=localhost
# DB_PORT=5432

# Option 3: MySQL/MariaDB
# Uncomment and configure:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=ndas_db
# DB_USER=ndas_user
# DB_PASSWORD=your-database-password
# DB_HOST=localhost
# DB_PORT=3306

# ============================================================================
# 3. STATIC AND MEDIA FILES
# ============================================================================

# URLs (usually don't need to change)
STATIC_URL=/static/
MEDIA_URL=/media/

# Paths (only needed in production)
# Development: Leave commented
# Production: Set to your server paths
# STATIC_ROOT=/path/to/static/
# MEDIA_ROOT=/path/to/media/

# ============================================================================
# 4. EMAIL CONFIGURATION
# ============================================================================

# Email backend
# Development: django.core.mail.backends.console.EmailBackend
# Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP settings (for production)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_TIMEOUT=10

# Default sender
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Email verification
# EMAIL_VERIFICATION_REQUIRED=True
# EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24

# ============================================================================
# 5. SSL/HTTPS CONFIGURATION
# ============================================================================

# HTTPS settings (production only)
# SECURE_SSL_REDIRECT=False
# SECURE_PROXY_SSL_HEADER=False
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# ============================================================================
# 6. COOKIE SECURITY
# ============================================================================

# Secure cookies (production with HTTPS)
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# Session timeout (seconds)
SESSION_COOKIE_AGE=3600

# ============================================================================
# 7. CACHE CONFIGURATION
# ============================================================================

# Redis cache (optional - improves performance)
# Leave empty for file-based cache
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# 8. RATE LIMITING
# ============================================================================

# Enable/disable rate limiting
# Development: False (for easier testing)
# Production: True (for security)
RATELIMIT_ENABLE=True

# ============================================================================
# 9. FILE UPLOAD LIMITS
# ============================================================================

# Maximum upload size (bytes)
# 104857600 = 100MB
# 2147483648 = 2GB
MAX_UPLOAD_SIZE=104857600

# Allowed file extensions
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,wmv,webm,mkv
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,txt

# ============================================================================
# 10. LOGGING
# ============================================================================

# Log level
# Development: DEBUG
# Production: INFO or WARNING
LOG_LEVEL=DEBUG

# ============================================================================
# 11. COMPRESSION
# ============================================================================

# Static file compression (production)
# COMPRESS_ENABLED=False
# COMPRESS_OFFLINE=False

# ============================================================================
# 12. ERROR TRACKING
# ============================================================================

# Sentry DSN (optional - for error monitoring)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# 13. BACKUP CONFIGURATION
# ============================================================================

# Backup settings (production)
# BACKUP_PATH=/path/to/backups/
# BACKUP_RETENTION_DAYS=30
# DB_BACKUP_ENABLED=True
# DB_BACKUP_SCHEDULE=daily

# ============================================================================
# 14. TIMEZONE AND LOCALIZATION
# ============================================================================

# Timezone
# Common options: UTC, Asia/Kolkata, America/New_York, Europe/London
# TIME_ZONE=UTC

# Language code
# LANGUAGE_CODE=en-us

# ============================================================================
# QUICK START GUIDE
# ============================================================================
#
# 1. For Local Development:
#    cp .env.development.example .env
#
# 2. For Production (Shared Hosting/cPanel):
#    cp .env.production.example .env
#    Edit: SECRET_KEY, ALLOWED_HOSTS, email settings, file paths
#
# 3. For Production (VPS with PostgreSQL):
#    cp .env.production.postgresql.example .env
#    Edit: SECRET_KEY, ALLOWED_HOSTS, database, email, file paths
#
# 4. After creating .env:
#    - Review and update all settings
#    - Run: python manage.py check
#    - Run: python manage.py migrate
#    - Production only: python manage.py collectstatic
#
# ============================================================================
# IMPORTANT NOTES
# ============================================================================
#
# - Keep .env file secure - NEVER commit it to version control
# - .env is already in .gitignore
# - Use different .env files for different environments
# - Always use DEBUG=False in production
# - Generate a new SECRET_KEY for production
# - Enable HTTPS in production (SECURE_SSL_REDIRECT=True)
# - Use strong database passwords
# - Regularly backup your database and media files
#
# ============================================================================
